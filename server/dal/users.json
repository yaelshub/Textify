import json
import os

# פונקציה שתבקש מהמשתמש להזין את המידע
def get_user_data():
    name = input("הכנס את שמך: ")
    rollno = input("הכנס את מספר הרישום: ")
    cgpa = input("הכנס את ה-CGPA שלך: ")
    phonenumber = input("הכנס את מספר הטלפון שלך: ")
    mail = input("הכנס כתובת מייל: ")

    user_data = {
        "name": name,
        "rollno": rollno,
        "cgpa": cgpa,
        "phone": phonenumber,
        "mail": mail
    }

    return user_data

# פונקציה שמוסיפה את המשתמש לקובץ JSON מבלי למחוק קודמים
def write_to_json(data, filename):
    if os.path.exists(filename):
        with open(filename, "r", encoding="utf-8") as infile:
            try:
                existing_data = json.load(infile)
            except json.JSONDecodeError:
                existing_data = []
    else:
        existing_data = []

    existing_data.append(data)

    with open(filename, "w", encoding="utf-8") as outfile:
        json.dump(existing_data, outfile, indent=4, ensure_ascii=False)

# הפעלת הקוד
user_data = get_user_data()
write_to_json(user_data, "users.json")
print("המידע נשמר בקובץ users.json")